# PostgreSQL — required once persistent counter storage is enabled.
# Keep the real value in Dokploy secrets; never commit it.
DATABASE_URL=postgresql://postgresql:axs9lisj9bkisqmg@31.220.57.164:5432/tapkingworld

# Visitor location — only enable behind an exclusive, trusted reverse proxy.
# Dokploy with direct Internet -> Traefik -> app: set to 1.
# Keep 0 for local development and any publicly reachable app port.
TRUSTED_PROXY_HOPS=0

# Next.js listens on this port inside the container. Dokploy should route to it.
PORT=3000

# Optional GeoIP database update settings (not needed for bundled-data lookup).
# LICENSE_KEY=
# GEODATADIR=
